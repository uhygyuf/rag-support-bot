      "type": "emoji",
      "value": "☕"
     },
     "initialMessages": "Hi! I'm the Harbor Coffee assistant ☕\nI answer only from our own FAQ, product and policy pages, and I'll pass anything I can't answer to a human.\nPick a topic below or type your question.",
     "suggestedPrompts": {
      "prompts": [
       {
        "icon": {
         "type": "emoji",
         "value": "🚚"
        },
        "text": "How long does US shipping take?"
       },
       {
        "icon": {
         "type": "emoji",
         "value": "🌍"
        },
        "text": "Do you ship to Canada?"
       },
       {
        "icon": {
