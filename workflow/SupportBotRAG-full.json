        },
        "text": "How much is the Ethiopia Guji?"
       },
       {
        "icon": {
         "type": "emoji",
         "value": "🔁"
        },
        "text": "Can I pause my subscription?"
       },
       {
        "icon": {
         "type": "emoji",
         "value": "🏪"
        },
        "text": "Do you offer wholesale pricing?"
       },
       {
        "icon": {
         "type": "emoji",
         "value": "🙋"
        },
        "text": "I want to talk to a human"
