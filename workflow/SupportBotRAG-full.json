        "id": "366bcad5-8ba9-44aa-a347-64faf981b14e",
        "name": "Reply Empty Input"
      },
      {
        "parameters": {
          "jsCode": "// A form upload can arrive under any binary key, and sometimes without a usable\n// file name. Hand the loader one stable key ('data') and a real source label, so\n// every stored chunk can be traced back to the document it came from.\nconst item = $input.first();\nconst bin = item.binary || {};\nconst key = Object.keys(bin)[0];\nconst file = key ? bin[key] : {};\nconst name = (file.fileName && file.fileName !== 'blob') ? file.fileName : 'document.md';\nfile.fileName = name;\nreturn [{ json: { sourceName: name }, binary: { data: file } }];"
        },
