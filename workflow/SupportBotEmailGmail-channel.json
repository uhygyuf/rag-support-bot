      {
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "// Turn one Gmail Trigger item into the fields the rest of the workflow uses.\n// The Gmail node can hand us two different shapes:\n//   (a) structured: { from: {value:[{address,name}]}, to: {...}, subject: \"..\", text: \"..\" }\n//   (b) raw Gmail API: { payload: { headers: [{name,value}], parts: [..] } }\n// We accept both, so the workflow keeps working if the trigger output ever changes.\nconst m = $input.first().json;\nconst NL = String.fromCharCode(10);\nconst CR = String.fromCharCode(13);\n\nfunction rawHeader(name) {\n  const hs = (m.payload && m.payload.headers) ? m.payload.headers : [];\n  for (const h of hs) {\n    if (String(h.name).toLowerCase() === String(name).toLowerCase()) return String(h.value);\n  }\n  return \"\";\n}\n\nfunction addressOf(value) {\n  if (!value) return \"\";\n  if (typeof value === \"string\") {\n    const inside = value.match(/<([^>]+)>/);\n    return (inside ? inside[1] : value).trim();\n  }\n  if (typeof value === \"object\" && Array.isArray(value.value) && value.value.length > 0) {\n    const first = value.value[0];\n    if (first && first.address) return String(first.address).trim();\n  }\n  return \"\";\n}\n\nfunction decodeBase64(data) {\n  if (!data) return \"\";\n  const safe = String(data).replace(/-/g, \"+\").replace(/_/g, \"/\");\n  return Buffer.from(safe, \"base64\").toString(\"utf8\");\n}\n\nfunction findPlainText(payload) {\n  if (!payload) return \"\";\n  if (payload.mimeType === \"text/plain\" && payload.body && payload.body.data) {\n    return decodeBase64(payload.body.data);\n  }\n  const parts = payload.parts || [];\n  for (const p of parts) {\n    const found = findPlainText(p);\n    if (found) return found;\n  }\n  if (payload.body && payload.body.data) return decodeBase64(payload.body.data);\n  return \"\";\n}\n\nlet from = addressOf(m.from) || rawHeader(\"From\");\nlet to = addressOf(m.to) || rawHeader(\"Delivered-To\") || rawHeader(\"To\");\nconst subject = (typeof m.subject === \"string\" && m.subject) ? m.subject : rawHeader(\"Subject\");\n\nlet body = \"\";\nif (typeof m.text === \"string\" && m.text) body = m.text;\nif (!body) body = findPlainText(m.payload);\nif (!body && typeof m.snippet === \"string\") body = m.snippet;\n\nconst clean = body.split(CR).join(NL).split(NL)\n  .filter(function (line) { return line.trim().charAt(0) !== \">\"; })\n  .join(NL).trim();\n\n// Some mail clients send subject-only emails. If the body is empty, use the\n// subject as the question instead of replying with a useless greeting.\nlet question = clean;\nif (!question) question = String(subject || \"\");\n\nreturn [{ json: {\n  question: question.slice(0, 1500),\n  from: String(from),\n  subject: String(subject),\n  to: String(to),\n  threadId: m.threadId || \"\",\n  messageId: m.id || \"\",                      // Gmail API id - what markAsRead needs\n  rfcMessageId: m.messageId || \"\"             // RFC header id, for threading/debug\n} }];"
        },
