{
  "id": "SupportBotEmail01",
  "name": "Support Bot — Email channel",
  "active": false,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "mailbox": "INBOX",
        "postProcessAction": "nothing",
        "format": "simple",
        "options": {}
      },
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2.2,
      "position": [
        -900,
        300
      ],
      "id": "4f23c7d9-bf85-4856-b079-cc7960aa664f",
      "name": "Email Trigger (IMAP)",
      "credentials": {
        "imap": {
          "id": "LA5QBt05vQlXu5PY",
          "name": "IMAP account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.to }}",
              "rightValue": "+support",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -660,
        300
      ],
      "id": "a0f277e6-8c61-4a86-b806-b6af5fb6fdd3",
      "name": "Is support mail?"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const m = $input.first().json;\nconst raw = (m.textPlain || m.text || '').toString();\nconst lines = raw.split(/\\r?\\n/);\nconst clean = lines.filter(function (l) { return l.trim().charAt(0) !== '>'; }).join('\\n').trim();\nlet from = m.from;\nif (from && typeof from === 'object') { from = (from.value && from.value[0] && from.value[0].address) || from.text || ''; }\nreturn [{ json: { question: clean.slice(0, 1500), from: String(from || ''), subject: String(m.subject || '') } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        300
      ],
      "id": "29f13960-bc12-4897-b627-a1a9de78ddc7",
      "name": "Prep Email Question"
    },
    {
      "parameters": {
        "fromEmail": "YOUR_EMAIL@example.com",
        "toEmail": "={{ $('Prep Email Question').first().json.from }}",
        "subject": "=Re: {{ $('Prep Email Question').first().json.subject }}",
        "text": "={{ $json.output }}",
        "options": {}
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1300,
        300
      ],
      "id": "88f3b5cd-6bb1-45fd-89db-500760e60f87",
      "name": "Send Email Reply",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "credentials": {
        "smtp": {
          "id": "RoVOo97jasbqF2eW",
          "name": "SMTP account"
        }
      }
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        -400,
        80
      ],
      "id": "d6a580fd-7f56-4fd3-b064-fa84f61d4dde",
      "name": "Ignore (not a support mail)"
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "SupportBotCore01",
          "mode": "list",
          "cachedResultName": "Support Bot — core (answers and handover)"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "question": "={{ $json.question }}",
            "channel": "email",
            "sessionKey": "={{ $json.threadId || $json.from }}"
          }
        }
      },
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        520,
        120
      ],
      "id": "b8d42b2b-f985-4bc3-a1f0-65eed9a45d70",
      "name": "Execute core"
    }
  ],
  "connections": {
    "Email Trigger (IMAP)": {
      "main": [
        [
          {
            "node": "Is support mail?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is support mail?": {
      "main": [
        [
          {
            "node": "Prep Email Question",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Ignore (not a support mail)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prep Email Question": {
      "main": [
        [
          {
            "node": "Execute core",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute core": {
      "main": [
        [
          {
            "node": "Send Email Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "nodeGroups": [],
  "pinData": {}
}